{
  "manifest_version": 3,
  "name": "arXiv Translate - Traduction Scientifique",
  "version": "1.0",
  "description": "Traduit les articles scientifiques arXiv en conservant les équations mathématiques (LaTeX/MathJax).",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://arxiv.org/*",
    "https://*.arxiv.org/*",
    "https://*.ar5iv.org/*",
    "https://generativelanguage.googleapis.com/*",
    "http://localhost/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "arXiv Translate",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://arxiv.org/html/*",
        "https://*.arxiv.org/html/*",
        "https://*.ar5iv.org/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
